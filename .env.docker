# ============================================
# Oriotel ERP — Environment Variables
# Copy this file to .env and adjust values
# ============================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=oriotel_root
MYSQL_USER=oriotel
MYSQL_PASSWORD=oriotel_secret
MYSQL_PORT=3307

# ---- Redis ----
REDIS_PORT=6379

# ---- API Gateway ----
GATEWAY_PORT=8080

# ---- phpMyAdmin ----
PMA_PORT=8081

