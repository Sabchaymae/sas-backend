APP_NAME="Oriotel Identity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oriotel_identity
DB_USERNAME=oriotel
DB_PASSWORD=oriotel_secret

# Session (not used — pure API)
SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=identity_

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@oriotel.com"
MAIL_FROM_NAME="Oriotel"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=oid_

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Vonage SMS (optional — for 2FA SMS)
# VONAGE_KEY=
# VONAGE_SECRET=
# VONAGE_SMS_FROM=Oriotel
