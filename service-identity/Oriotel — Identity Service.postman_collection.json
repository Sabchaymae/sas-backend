    {
      "name": "🔓 Public — Auth",
      "item": [
        {
          "name": "Login — Admin (triggers 2FA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.action === 'two_factor_required') {",
                  "  pm.collectionVariables.set('user_id_2fa', res.user_id);",
                  "  console.log('2FA requis — user_id:', res.user_id);",
                  "}",
                  "if (res.action === 'authenticated') {",
                  "  pm.collectionVariables.set('auth_token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
