# ============================================
# Oriotel ERP — Environment Variables
# Copy this file to .env and adjust values
# ============================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=oriotel_root
MYSQL_USER=oriotel
MYSQL_PASSWORD=oriotel_secret
MYSQL_PORT=3307

# ---- Redis ----
REDIS_PORT=6379

# ---- API Gateway ----
GATEWAY_PORT=8080

# ---- Laravel Reverb (WebSockets) ----
REVERB_APP_ID=oriotel
REVERB_APP_KEY=oriotel_reverb_key
REVERB_APP_SECRET=oriotel_reverb_secret
REVERB_HOST=localhost
REVERB_PORT=8085
REVERB_SCHEME=http

# ---- phpMyAdmin ----
PMA_PORT=8081


# ---- Laravel Reverb (WebSockets) ----
REVERB_APP_ID=oriotel
REVERB_APP_KEY=oriotel_reverb_key
REVERB_APP_SECRET=oriotel_reverb_secret
REVERB_HOST=localhost
REVERB_PORT=8085
REVERB_SCHEME=http

